   <text>
      <front>
         <div type="original_front">
            <pb facs="#facs_" n=""/>
            <milestone unit="section" facs="#facs__tr_3"/>
            <p>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/978,78,512,131" n="N001"/>1<anchor xml:id="m1-1"/>g. StP. Cämmerey bez.
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/1092,158,186,90" n="N002"/>P. P.
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/930,253,707,186" n="N003"/>Insonders hochgeehrteste Herren
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/1064,375,333,91" n="N004"/>und Patroni,
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/878,510,793,216" n="N005"/>Ew. HochEhrw. Magnific. und Hoch<span type="hyphen">-</span>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/874,685,807,109" n="N006"/>Edl. Herrl. sollen in schuldigster
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/870,758,809,107" n="N007"/>Submission nicht verhalten, welcher<span type="hyphen">-</span>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/875,834,792,110" n="N008"/>gestallt, alß der Cantor bey allhie<span type="hyphen">-</span>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/866,906,796,121" n="N009"/>siger StadtSchulen, Victorinus Irmisch,
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/848,994,836,116" n="N010"/>den 8. Junij lezthin, dieses Zeitliche
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/866,1061,782,133" n="N011"/>geseegnet, wir als patroni hie<span type="hyphen">-</span>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/859,1144,820,146" n="N012"/>siger Kirchen und Schulen unßere<add xml:id="add1" place="inspace" hand="Autor" type="correction">unß eine</add>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/754,1238,918,144" n="N013"/><del rend="strikethrough" hand="Autor">größeste</del><add xml:id="add2" place="inspace" hand="Autor" type="correction">der größesten</add> Sorge mit seyn laßen,
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/862,1325,765,130" n="N014"/>solches dadurch vacant-gewor<span type="hyphen">-</span>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/862,1392,802,140" n="N015"/>dene Cantorat mit einem<del rend="strikethrough" hand="Autor"> andern</del><add xml:id="add3" place="inspace" hand="Autor" type="correction">ander<span type="hyphen">-</span>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/669,1500,914,126" n="N016"/>weiten</add> tüchtigen Subjecto zuersezen.
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/853,1593,788,114" n="N017"/>zu welchen Ende wir dann auch
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/850,1674,782,110" n="N018"/>nicht nur umb recommendation
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/848,1752,784,95" n="N019"/>ein- und des andern qvalificirten
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/827,1807,828,127" n="N020"/>Subjecti, bey dem berühmten Dire<span type="hyphen">-</span>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/837,1896,779,117" n="N021"/>ctore Musices, Herrn Johann Sebastian
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/810,1981,837,142" n="N022"/>Bachen zu Leipzig, angesuchet, sondern
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/834,2061,764,131" n="N023"/>auch hier und da umb solche
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/837,2141,777,127" n="N024"/>Personen, welche sowohl in Dirigi<span type="hyphen">-</span>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/840,2205,814,138" n="N025"/>rung der Music in der Kirchen und
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/825,2270,790,141" n="N026"/>sonsten, als auch bey hiesiger Stadt<span type="hyphen">-</span>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/819,2352,824,131" n="N027"/>Schule, soviel tertiam et class quar<span type="hyphen">-</span>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/824,2438,805,116" n="N028"/>tam Classem concerniret in humanio<span type="hyphen">-</span>
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/824,2497,782,128" n="N029"/>ribus et primis Elementis nüzliche</p>
         </div>
         <div type="commentary_front">
         <p/>
         </div>
         <div type="marginalia_front">
            <ab type="margin_front">
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/357,104,85,105" n="N001"/><note target="m1-1" place="margin-left" type="marginalia">An
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/197,171,596,134" n="N002"/>das HochLöbl. Consistorium
               <lb facs="iiif:0001_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00159.tif/335,281,307,42" n="N003"/>zu Leipzig p.</note>
