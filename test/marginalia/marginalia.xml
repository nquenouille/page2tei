      <body>
         <div type="original">
            <pb facs="#facs_2" n="2"/>
            <milestone unit="section" facs="#facs_2_tr_2"/>
            <p>
               <lb facs="iiif:/1185,220,832,166" n="N001"/>Dienste leisten <unclear reason="illegible"> </unclear><add xml:id="add4" place="inspace" hand="Autor" type="correction">möchten</add>, behörige Nach<span type="hyphen">-</span>
               <lb facs="iiif:/1189,312,860,138" n="N002"/>frage gehalten. Gleich wie <del rend="strikethrough" hand="Autor">wir</del>
               <lb facs="iiif:/1174,403,878,137" n="N003"/>nun hierauf, von denenjenigen,<anchor xml:id="a1" type="add"/>
               <lb facs="iiif:/1589,402,449,58" n="N004"/><add xml:id="ta1" place="above" hand="Autor" type="correction">unterschiedliche Subjecta</add>
               <lb facs="iiif:/1155,472,834,140" n="N005"/>so sich schrifftlich darumb beworben
               <lb facs="iiif:/1181,555,824,154" n="N006"/>auch gedachter Herr Cantor zu Leip<span type="hyphen">-</span>
               <lb facs="iiif:/1164,628,834,174" n="N007"/>zig Herr Bach unterm 26.sten Sept.
               <lb facs="iiif:/1182,711,867,146" n="N008"/>jüngsthin Herrn Georg Gottfried Wagnern
               <lb facs="iiif:/1183,775,852,126" n="N009"/>SS. Theol. Studios. aus Wurzen ge<span type="hyphen">-</span>
               <lb facs="iiif:/1187,867,823,128" n="N010"/>bürtig, wie dieser sowohl in huma<span type="hyphen">-</span>
               <lb facs="iiif:/1185,939,820,121" n="N011"/>nioribus, als besonders in Musi<span type="hyphen">-</span>
               <lb facs="iiif:/1180,1022,825,141" n="N012"/>cis sehr wohl versiret sey, als
               <lb facs="iiif:/1189,1089,826,134" n="N013"/>ein habiles Subjectum <anchor xml:id="a2" type="add"/> recommendiret,
               <lb facs="iiif:/1633,1087,197,41" n="N014"/><add xml:id="ta2" place="above" hand="Autor" type="addition">insonderheit</add>
               <lb facs="iiif:/1144,1168,891,148" n="N015"/>auch<anchor xml:id="m2-1"/> sogar Ihro HochEhrwürdige<add xml:id="add5" place="inspace" hand="Autor" type="correction">HochEhrwürd.</add> Magnif.
               <lb facs="iiif:/1074,1240,936,157" n="N016"/>Tit. Herr Superint. ihres Orths D. Salo<span type="hyphen">-</span>
               <lb facs="iiif:/1169,1322,866,153" n="N017"/>mon Deyling, <anchor xml:id="a3" type="add"/> daß dieser H. Wagner
               <lb facs="iiif:/1180,1384,836,140" n="N018"/>auf der Thomas-Schule zu Leipzig
               <lb facs="iiif:/1149,1480,866,124" n="N019"/>Sieben Jahr gelebet, und allda seine
               <lb facs="iiif:/1144,1546,859,130" n="N020"/>Fundamenta durch Gottes Gnade in
               <lb facs="iiif:/1142,1632,864,126" n="N021"/>Literis und Musicis geleget, auch
               <lb facs="iiif:/1162,1705,868,126" n="N022"/>nach der Zeit auf hiesiger gedachter
               <lb facs="iiif:/1177,1771,830,130" n="N023"/>Universitaet Leipzig die Collegia
               <lb facs="iiif:/1148,1847,880,136" n="N024"/>Theologica und Philosophica fleißig
               <lb facs="iiif:/1159,1931,828,134" n="N025"/>freqventiret, auch<add xml:id="add6" place="inspace" hand="Autor" type="correction">und</add> in Musicis ver<span type="hyphen">-</span>
               <lb facs="iiif:/1187,1997,825,135" n="N026"/>schiedene Proben abgeleget habe,
               <lb facs="iiif:/1225,2079,805,106" n="N027"/><del rend="strikethrough" hand="Autor">solcher halben dem</del> Selbsten glaub<span type="hyphen">-</span>
               <lb facs="iiif:/1200,2169,838,113" n="N028"/>würdig <anchor xml:id="m2-2" type="marginalia"/> attestiret und ihn zu<add xml:id="add7" place="inspace" hand="Autor" type="correction">auch</add> zu
               <lb facs="iiif:/1341,2162,315,35" n="N029"/><add xml:id="ta4" place="above" hand="Autor" type="addition">und wohlbedachtig</add>
               <lb facs="iiif:/1213,2223,813,112" n="N030"/>diesen verledigten Cantorat <anchor xml:id="a5" type="add"/> vor
               <lb facs="iiif:/1210,2314,844,103" n="N031"/>anderen wohlbedachtig gleichfalls
               <lb facs="iiif:/1228,2354,804,113" n="N032"/>recommendiert, vor qvalificirt und
               <lb facs="iiif:/1204,2429,821,147" n="N033"/>darzu tüchtig zu seyn erachtet; <del rend="strikethrough" hand="Autor">Also</del>
               <lb facs="iiif:/996,2484,1036,166" n="N034"/><add xml:id="add8" place="margin-left" hand="Autor" type="addition">hierüber</add> nur erwehnter H. Wagner
               <lb facs="iiif:/1212,2556,826,123" n="N035"/><del rend="strikethrough" hand="Autor">auch</del> unterm 19. Octobr a. c. in
               <lb facs="iiif:/1212,2603,804,158" n="N036"/>einem geschickten lateinischen Schreiben
               <lb facs="iiif:/1203,2666,861,178" n="N037"/>selbsten umb das Cantorat angehalten; Also
            </p>
         </div>
         <div type="commentary">
         <p/>
         </div>
         <div type="marginalia">
            <ab type="margin_body">
               <lb facs="iiif:/447,1351,546,128" n="N001"/><note target="m2-1" place="margin-left" type="marginalia">als welchen hiesiger Kirchen
               <lb facs="iiif:/488,1434,520,81" n="N002"/>und Schulen Zustandt gar
               <lb facs="iiif:/517,1485,251,96" n="N003"/>wohl bekandt,</note>
            </ab>
            <ab type="margin_body">
               <lb facs="iiif:/447,2227,640,103" n="N001"/><note target="m2-2" place="margin-left" type="marginalia">als welchen hiesiger Kirchen
               <lb facs="iiif:/509,2300,609,85" n="N002"/>und Schulen Zustandt mehr
               <lb facs="iiif:/515,2365,502,91" n="N003"/>als zu wohl bekandt,</note>
            </ab>
         </div>
      </body>
         <back>
         <div type="original_back">
            <pb facs="#facs_" n=""/>
            <milestone unit="section" facs="#facs__tr_3"/>
            <p>
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/892,157,810,148" n="N001"/>haben wir sowohl zwey von denen
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/707,275,1011,126" n="N002"/>anderen Competenten, als auch in specie <add place="above">\dem/</add> com<span type="hyphen">-</span>
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/905,359,797,95" n="N003"/>mendation Wagnern ver einer <del rend="strikethrough">ge<span type="hyphen">-</span>
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/907,421,788,119" n="N004"/>wißen Gastmusis</del> <add place="above">\respective/</add> den 20. 21. und
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/896,482,770,134" n="N005"/>23sten post Trinitat: mit Ihrer
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/715,565,992,154" n="N006"/>Gast¬Music in allhiesiger Kirche gehöret
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/898,629,838,137" n="N007"/>und, weiln <add place="above">\mag/</add> unter diesen dreyen Musicis
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/900,716,821,119" n="N008"/>vielerwehnten Wagnern, als welcher
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/894,786,811,117" n="N009"/>insonderheit die ihme vorgegebene
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/866,845,869,147" n="N010"/>Themata <del rend="strikethrough">von anderen</del> <add place="above">\nicht alleine/</add> <del rend="strikethrough">aufs beste</del> <add place="above">\<del rend="strikethrough">sehr</del> wohl/</add> com<span type="hyphen">-</span>
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/903,925,806,163" n="N011"/>poniret, <del rend="strikethrough">auch(?)</del> <add place="above">\<del rend="strikethrough">sondern</del> so thane(?) Musik/</add> vor anderen wohl dici<span type="hyphen">-</span>
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/902,1002,785,160" n="N012"/>giret, mithin pro dignissimo gehal<span type="hyphen">-</span>
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/892,1098,779,121" n="N013"/>ten, <del rend="strikethrough">Ihnen</del> \Ihn/sondern, <del rend="strikethrough">also ihme</del> von
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/903,1168,792,133" n="N014"/>allhiesigen Herrn Superintendenten
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/891,1230,790,143" n="N015"/>M. Hermannen <add place="above">\Ihme/</add> Kirche und Chor<anchor xml:id="m3-1"/>  <add place="above">\gewöhnl. maßen/</add>, <del rend="strikethrough">an</del>
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/898,1373,780,160" n="N016"/>Probe mündlich ersucheten welche
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/898,1431,819,163" n="N017"/>Probe¬Music er auch gestriges Tages,
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/892,1528,796,134" n="N018"/>als Domin: II. Adventus gebührend
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/896,1607,792,152" n="N019"/>abgeleget hat. Und nachdeme
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/889,1687,777,137" n="N020"/>wir, nach hiesiges Orthes herge<span type="hyphen">-</span>
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/883,1756,818,152" n="N021"/>brachter Observanz unß, vermöge
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/879,1813,828,169" n="N022"/>unßers habenden juris patronatus
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/882,1883,789,160" n="N023"/>anheute zusammen gesezet, die
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/889,1942,841,192" n="N024"/>3. <del rend="strikethrough">Suß</del> Subjecta nehml. <del rend="strikethrough">Johann</del> <add place="above">\Georg/</add> Gottfried
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/881,2036,796,180" n="N025"/>Wagnern, Johann Gottfried Grünern
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/879,2118,801,143" n="N026"/>und Carl Ludwig Westflocken
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/882,2198,772,147" n="N027"/>als welche allerseits obangeführ<span type="hyphen">-</span>
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/879,2254,816,183" n="N028"/>ter maßen sich in der Music würkl.
               <lb facs="iiif:0003_d_plsta_rep_i_kap_iv_sekt_i_d_nr_1_00161.tif/887,2381,800,158" n="N029"/>sich hören laßen, denominiret</p>
         </div>
