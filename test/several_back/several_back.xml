   <text>
      <body>
         <div n="1" type="original">
         <pb facs="#facs_1" n="1"/>
         <milestone unit="section" facs="#facs_1_r_69"/>
         <p>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/380,185,827,162" n="N001"/>Einkom. den 23. Sept.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/769,302,211,69" n="N002"/>1733.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/219,404,364,140" n="N003"/>An das
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/302,515,429,125" n="N004"/>Chur- und
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/275,614,686,121" n="N005"/>Fürstl. Sächß.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/269,686,854,129" n="N006"/>Consistorium all<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/241,788,750,127" n="N007"/>hier zu Leipzig.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/930,1034,336,111" n="N008"/>P. P.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/247,1073,1276,230" n="N009"/>Ew. HochEdelgeb. Magnif.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/280,1217,1249,171" n="N010"/>HochEhrwd. auch HochEdl. Herrl.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/311,1306,1209,141" n="N011"/>können wir hierdurch gehorsamst
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/271,1397,1196,135" n="N012"/>zu hinterbringen nicht un<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/289,1480,1197,115" n="N013"/>terlaßen, was maßen der
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/234,1561,1279,160" n="N014"/>hiesige Kauff- und Handels-
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/309,1665,1200,122" n="N015"/>Mann, HE. Johann Friedrich
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/269,1752,1241,132" n="N016"/>Eitelwein auf erhaltnen Gnä<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/294,1828,1205,128" n="N017"/>digsten Befehl, ohne Aufgeboth
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/222,1914,1258,128" n="N018"/>sich mit seiner Verlobten,
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/331,1995,1177,126" n="N019"/>der Jfr. Sieberin, trauen zu
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/319,2081,1147,109" n="N020"/>laßen, die Erlaubniß er<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00201.tif/264,2153,1197,151" n="N021"/>halten, da nun auf Produ<span type="hyphen">-</span>
            </p>
         <pb facs="#facs_2" n="2"/>
         <milestone unit="section" facs="#facs_2_tr_1"/>
         <p>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/647,259,1210,127" n="N001"/>ction obangezogenen gnädigsten
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/653,342,1201,150" n="N002"/>Befehls, Se. HochEhrwd. Magnif.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/656,412,1218,151" n="N003"/>der Herr Superintendens all<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/610,521,1207,126" n="N004"/>hier, D. Salomon Deyling, des
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/665,607,1194,112" n="N005"/>Bräutigams Verlangen an
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/647,684,1202,133" n="N006"/>den Pfarr zu Plausig der
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/634,770,1234,140" n="N007"/>Trauung halber Verordnung
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/653,848,1198,140" n="N008"/>ergehen zu laßen, deferiret;
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/667,953,1184,114" n="N009"/>So haben wir wegen unsrer
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/677,1033,1190,146" n="N010"/>Gebühren uns bey H. Eitelwei<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/675,1129,1187,127" n="N011"/>nen gemeldet hätten auch
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/699,1226,1167,117" n="N012"/>gewiß geglaubet, es wür<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/683,1294,1172,114" n="N013"/>de derselbe sich hierunter
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/670,1366,1123,134" n="N014"/>der Billigkeit bescheiden.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/649,1472,1217,111" n="N015"/>Nachdem wir aber nicht son<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/706,1535,1133,143" n="N016"/>der Befremdung erfahren
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/691,1610,1181,134" n="N017"/>müßen, daß Herr Eitel<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/627,1707,1253,154" n="N018"/>wein, unter dem wiederrecht<supplied resp="hdv-svt54" reason="ommitted-in-original"><span type="hyphen">-</span></supplied>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/712,1788,1151,133" n="N019"/>lichen unstatthafften Vor<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/658,1878,1208,136" n="N020"/>wande: Er gäbe Niemanden
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/701,1948,1173,155" n="N021"/>nichts, sich der schuldigen Zah<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/706,2038,1148,121" n="N022"/>lung entbrechen, auch keine
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/641,2117,1233,125" n="N023"/>Vorstellung gelten laßen will,
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00202.tif/635,2190,1215,126" n="N024"/>Wir hergegen dabey um
            </p>
         <pb facs="#facs_3" n="3"/>
         <milestone unit="section" facs="#facs_3_tr_1"/>
         <p>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/331,305,1244,123" n="N001"/>willen nicht aquiesciren kön<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/379,395,1206,125" n="N002"/>nen, weil 1) diese Gebühren uns
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/380,479,1198,126" n="N003"/>zugleich Salarii loco ausgema<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/372,578,1172,134" n="N004"/>chet worden 2) in dergleichen
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/383,651,1179,147" n="N005"/>Fällen es jederzeit also gehal<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/408,735,1175,165" n="N006"/>ten zu werden pfleget, daß
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/375,832,1163,146" n="N007"/>derjenige, so sich außerhalb
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/400,916,1166,151" n="N008"/>Leipzig trauen laßen will,
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/387,1016,1150,151" n="N009"/>dennoch das gewöhnliche Hono<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/399,1100,1173,128" n="N010"/>rarium an die Kirchen-Bedien<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/414,1166,1158,159" n="N011"/>ten und Schüler zu bezah<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/400,1266,1148,117" n="N012"/>len verbunden ist, auch 3)
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/331,1360,1171,105" n="N013"/>wie aus dem Adjecto Sub A
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/317,1437,1189,142" n="N014"/>zu ersehen, von der hohen
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/371,1507,1181,141" n="N015"/>Landes Obrigkeit verordnet
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/340,1615,1223,111" n="N016"/>worden, nichts destoweni<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/339,1689,1141,129" n="N017"/>ger in loco domicilii, die
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/385,1779,1152,136" n="N018"/>ordentlichen Gebühren zu
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/388,1862,1187,139" n="N019"/>entrichten, und besonders
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/378,1956,1172,124" n="N020"/>4) da Braut und Bräuti<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/316,2048,1219,163" n="N021"/>gam hieselbst wohnhafft
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00203.tif/348,2145,1238,151" n="N022"/>selbige uns nicht zu ent<span type="hyphen">-</span>
            </p>
         <pb facs="#facs_4" n="4"/>
         <milestone unit="section" facs="#facs_4_tr_1"/>
         <p>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/560,263,1288,167" n="N001"/>ziehen sind, auch endlich 5) pro<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/623,367,1204,171" n="N002"/>pter consequentiam, derglei<supplied resp="fpb-svt54" reason="ommitted-in-original"><span type="hyphen">-</span></supplied>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/634,460,1227,142" n="N003"/>chen eigenmächtiger Abbruch
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/639,571,1195,122" n="N004"/>nicht zu erdulden stehet, im<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/644,639,1206,138" n="N005"/>maßen 6) per ordin. Elect.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/650,734,1198,150" n="N006"/>Eccles. Artic. gen. 20 § und
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/642,806,1211,158" n="N007"/>nachdem it. Artic. 22. § ult.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/642,908,1206,150" n="N008"/>ausdrückl. enthalten, daß
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/644,1006,1203,113" n="N009"/>denen Kirchen- und Schuldie<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/673,1099,1157,118" n="N010"/>nern an ihren Einkünfften
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/688,1185,1168,124" n="N011"/>nichts entzogen werden soll;
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/696,1283,1123,119" n="N012"/>Alß wenden wir uns zu
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/697,1345,1158,142" n="N013"/>Ew. HochEdelgeb. Magnif.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/663,1422,1168,172" n="N014"/>HochEhrwd. auch HochEdl. Herrl.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/633,1518,1204,146" n="N015"/>gerechtliebenden Gütigkeit,
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/674,1609,1173,135" n="N016"/>demüthigst bittende, Dieselben
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/635,1689,1199,134" n="N017"/>geruhen uns bey denen zu un<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/615,1769,1232,158" n="N018"/>serm Unterhalt ausgesezten
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/665,1862,1172,140" n="N019"/>Einkünfften kräfftigst zu
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/554,1951,1305,202" n="N020"/>schützen, und HE. Eitelweinen
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/642,2038,1203,157" n="N021"/>durch den Rath zu Leipzig
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/655,2120,1208,141" n="N022"/>auferlegen zu laßen, daß
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00204.tif/670,2203,1180,158" n="N023"/>er die gewöhnl. Gebühren
            </p>
         <pb facs="#facs_5" n="5"/>
         <milestone unit="section" facs="#facs_5_tr_1"/>
         <p>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/436,289,1142,153" n="N001"/>ohne fernern Anstandt an uns
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/399,416,1182,133" n="N002"/>entrichten, auch alle verursach<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/443,494,1066,139" n="N003"/>te Unkosten erstatten müße.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/345,567,1253,152" n="N004"/>Wir deveneriren diese hohe Ver<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/271,645,1327,225" n="N005"/>fügung mit unterthäni<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/411,757,1165,130" n="N006"/>gen Dancke, und verharren
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/416,840,1149,141" n="N007"/>mit der devotesten Submis<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/341,918,277,162" n="N008"/>sion
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/785,1085,523,128" n="N009"/>P. P.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/746,1824,816,151" n="N010"/>unterthänig-gehor<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/726,1939,533,147" n="N011"/>samste
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/611,2050,949,141" n="N012"/>Joh. Sebast. Bach Dir. Mus.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/781,2127,687,93" n="N013"/>u. Cant. zu S. Thomae.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/717,2180,468,143" n="N014"/>Joh. Schneider
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/1012,2238,551,136" n="N015"/>Org. zu S. Nicol.
               <lb facs="iiif:fpb%2FD-LEsa%2Fraoa6%2Fd_lesa_0008_ratsstube_3369_00205.tif/496,2324,1006,112" n="N016"/>M. Joh. Matthias Gesner wegen der
