   <x:scenario label="T1">
      <x:context mode="combine-hi" xml:space="preserve">
         <p facs="#facs_108_TextRegion_1679295339003_2280">
            <lb facs="#facs_108_TextRegion_1679295339003_2280_tl_1" n="N001"/>Ich denke zu dem ersten Stück folgendes zu geben, wobey ich Euch
            <lb facs="#facs_108_TextRegion_1679295339003_2280_tl_2" n="N002"/>noch allerley um Rath zu fragen habe. Erstlich <hi style="font-style: italic;">vier <hi style="font-weight: bold;">Briefe</hi> über W[il¬</hi>
            <lb facs="#facs_108_TextRegion_1679295339003_2280_tl_3" n="N003"/><hi style="font-style: italic;">helm] M[eister]</hi>, vielleicht auch nur <hi style="font-style: italic;">drey</hi><comment superscript="true"><hi style="vertical-align: superscript;">37</hi></comment>, nach Befinden der Um¬
            <lb facs="#facs_108_TextRegion_1679295339003_2280_tl_4" n="N004"/>stände.</p>
      </x:context>
      <x:expect label="." xml:space="preserve">
