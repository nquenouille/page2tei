        <row n="4">
          <cell facs="iiif:d_efsa_1_1_staedtische_akten_bis_1871_4_116_00022.tif/565,2768,1796,174" n="0" rend="0000">
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00022.tif/605,2736,1508,221" n="N001"/>und Mstr. Georg Balthasar Syrings Kinder</cell>
          <cell facs="iiif:d_efsa_1_1_staedtische_akten_bis_1871_4_116_00022.tif/2103,2768,576,174" n="1" rend="0000">
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00022.tif/2113,2739,555,185" n="N001"/>zwanzig Gülden</cell></row></table>
         <milestone unit="section" facs="#facs_4_r_1"/>
         <p>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00022.tif/836,2898,1761,232" n="N001"/>zu vermächtnißen also bald nach geendigten
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00022.tif/836,3015,1835,224" n="N002"/>Trauer Monathe von meinen gesamten Nachlaße
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00022.tif/849,3181,1790,269" n="N003"/>empfangen, haben, und behalten sollen; Ingleichen
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00022.tif/797,3346,1880,257" n="N004"/><anchor xml:id="m4-2"/>Legire ich 5) einen jeden meiner zur zeit</p>
         <p>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00022.tif/994,3526,1609,285" n="N001"/><note target="m4-1" place="bottom" type="marginalia">(L S) Martha Catharina Lemmerhirtin</note>
            </p>
         <pb facs="#facs_5" n="5"/>
         <milestone unit="section" facs="#facs_5_r_1"/>
         <p>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/486,689,1704,255" n="N001"/>meines seel. Absterbens annoch leedigen
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/365,870,1861,245" n="N002"/>Tauff Pathen, die zu seiner ausstattung in
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/495,1013,1747,232" n="N003"/>vorerwehnten Testamento Recipro<del rend="strikethrough"><unclear reason="illegible"> </unclear></del><add xml:id="add5-1" place="inspace" type="correction">c</add>o dem<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/392,1154,1798,317" n="N004"/>selben bereits beschiedene Fünff Gülden
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/483,1282,1767,252" n="N005"/>um meiner darbey in besten zu geden<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/445,1480,1778,232" n="N006"/><anchor xml:id="m5-1"/>cken: Hiernechst und 6) instituire, be<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/483,1638,1795,257" n="N007"/>nenne und seze ich hiermit ein zu wahren
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/464,1753,1806,291" n="N008"/>Erben meiner und meines seel. Eheman<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/476,1922,1795,247" n="N009"/>nes auf mich Erb und Eigenthuml. trans<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/387,2089,1882,325" n="N010"/>ferirten Verlaßenschafft unsere beyderseits
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/458,2217,1827,277" n="N011"/>liebe bluts Freünde und nechste anver<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/495,2374,1825,234" n="N012"/>wandte wie auch deroselben Erben, Nahment<supplied resp="fpb-4cugq" reason="omitted-in-original"><span type="hyphen">-</span></supplied>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/513,2520,1707,258" n="N013"/>lich. Frau Annen Christianen Zimmermannen
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/591,2708,1072,229" n="N014"/>H. Joh. Christoph Bachen
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/537,2831,1001,233" n="N015"/>H. Sebastian Bachen
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/520,3001,1029,249" n="N016"/>H. Jacob Bachen, und
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/419,3115,1792,299" n="N017"/>Fr. Marien Salome Wieganden wie auch
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/404,3281,1192,301" n="N018"/>Fr. Magdalena Hochin
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/435,3402,1541,239" n="N019"/>H. Albrecht Wilhelm Rudolphi
            </p>
         <p>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00023.tif/448,3556,1729,267" n="N001"/><note target="m5-1" place="bottom" type="marginalia">L. S. Martha Catharina Lemmerhirtin</note>
            </p>
         <pb facs="#facs_6" n="6"/>
         <milestone unit="section" facs="#facs_6_r_1"/>
         <p>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/927,691,1652,299" n="N001"/>H. Joh. Egidij Bachs Kinder lezter Ehe
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/789,887,1879,305" n="N002"/>Fr. Catharina Laurenzin gebohrne Syringen
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/881,1040,1805,248" n="N003"/>und Mstr. Georg Balthasar Syrings Kinde<supplied resp="fpb-4cugq" reason="binding">r.</supplied>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/796,1235,1879,219" n="N004"/>Dergestalt und also, daß dieße meine insti<supplied resp="fpb-4cugq" reason="omitted-in-original"><span type="hyphen">-</span></supplied>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/820,1394,1857,221" n="N005"/>tuirte Erben sothane gesamte Verlaßenschafft
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/828,1531,1848,206" n="N006"/>nach Abzug derer begräbniß Kosten und obi<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/812,1650,1850,225" n="N007"/>ger Vermächtniße in zehen Theile unter sich
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/810,1818,1827,224" n="N008"/>in Gott gefälliger Einigkeit auffs gleicheste
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/716,1961,1952,245" n="N009"/>Friedlich vertheilen, und ein jeder Erbe sei<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/839,2101,1811,227" n="N010"/>nen antheil, so dann Erb und eigenthüml.
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/771,2240,1909,250" n="N011"/>haben und behalten solle. Womit ich dann
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/862,2397,1808,206" n="N012"/><anchor xml:id="m6-1"/>7) dießen Meinen lezten Willen in Nahmen
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/844,2530,1837,257" n="N013"/>Gottes beschließe, und hierbey ausdrückl. ver<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/879,2719,1781,205" n="N014"/>ordne, daß wenn selbiger nicht als ein zier<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/874,2861,1803,235" n="N015"/>liches Testament bestehen könte, dennoch als
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/879,3031,1795,241" n="N016"/>ein Codicill Fidei Commiss geschencke auf
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/879,3182,1798,263" n="N017"/>den Todtes Fall, oder auff alle andere Rechts<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/892,3360,1786,241" n="N018"/>beständigste weiße völlig gelten, und hierüber
            </p>
         <p>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00024.tif/858,3533,1600,273" n="N001"/><note target="m6-1" place="bottom" type="marginalia">(L S) Martha Catharina Lemmerhirtin</note>
            </p>
         <pb facs="#facs_7" n="7"/>
         <milestone unit="section" facs="#facs_7_r_25"/>
         <p>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00025.tif/444,709,1724,207" n="N001"/>unverbrüchl. gehalten werden solle; Aller<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00025.tif/420,874,1738,235" n="N002"/>maßen ich dieße meine Disposition, wel<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00025.tif/410,1030,1733,225" n="N003"/>che ich bey Einen HochEdlen und Hochweißen
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00025.tif/406,1170,1734,213" n="N004"/>Rath Persönl. zu insinuiren mit Gott ent<span type="hyphen">-</span>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00025.tif/288,1313,1823,288" n="N005"/>schloßen bin, auf allen blat Seiten Eigen<supplied resp="fpb-4cugq" reason="omitted-in-original"><span type="hyphen">-</span></supplied>
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00025.tif/356,1436,1796,277" n="N006"/>händig unterschrieben und versiegelt habe.
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00025.tif/438,1627,1636,223" n="N007"/>So geschehen Erffurth den 8. Octobr.
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00025.tif/459,1814,613,203" n="N008"/>Anno. 1720.
               <lb facs="iiif:fpb%2FD-EFsa%2Fou19v%2Fd_efsa_1_1_staedtische_akten_bis_1871_4_116_00025.tif/413,1965,1750,301" n="N009"/>L. S. Martha Catharina Lemmerhirtin.
            </p>
